<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>OpenBattlefront</RootNamespace>
    <AssemblyName>OpenBattlefront</AssemblyName>
    <Version>0.1.0</Version>
    <Product>OpenBattlefront</Product>
    <Description>Launcher for OpenSWBF2</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- the in-app ModDB window for Essential mods; the runtime ships with Windows 10 and 11 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenBattlefront.Core\OpenBattlefront.Core.csproj" />
  </ItemGroup>

</Project>
