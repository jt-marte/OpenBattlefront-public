<UserControl x:Class="OpenBattlefront.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
        <Style x:Key="RowNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Faint}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Divider" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{StaticResource Line}" />
            <Setter Property="Margin" Value="0,14" />
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Margin="0,40,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,10,40,32">
            <TextBlock Text="Settings" Style="{StaticResource H2}" Margin="0,0,0,22" />

            <!-- Game build -->
            <TextBlock Text="GAME" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,22" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding InstalledBuild}" Style="{StaticResource RowTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="Updates come from github.com/jt-marte/OpenSWBF2 releases." Style="{StaticResource RowNote}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Small}" Content="{Binding RollBackLabel}" Command="{Binding RollBackCommand}"
                                Visibility="{Binding CanRollBack, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource Small}" Content="Install from file…" Command="{Binding InstallFromFileCommand}" />
                        <Button Style="{StaticResource Small}" Content="Check for updates" Command="{Binding CheckUpdatesCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Launch -->
            <TextBlock Text="LAUNCH" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,22" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Renderer" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Game setting follows Options > Video in the game." Style="{StaticResource RowNote}" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="3">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" Content="Game setting" GroupName="Renderer"
                                             IsChecked="{Binding Renderer, Converter={StaticResource Eq}, ConverterParameter=game}" />
                                <RadioButton Style="{StaticResource Segment}" Content="Vulkan" GroupName="Renderer"
                                             IsChecked="{Binding Renderer, Converter={StaticResource Eq}, ConverterParameter=vulkan}" />
                                <RadioButton Style="{StaticResource Segment}" Content="DirectX 9" GroupName="Renderer"
                                             IsChecked="{Binding Renderer, Converter={StaticResource Eq}, ConverterParameter=d3d9}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Player name" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{Binding ProfilesNote}" Style="{StaticResource RowNote}" TextWrapping="Wrap" Margin="0,0,12,0" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource Field}" Width="250" MaxLength="15"
                                 Text="{Binding PlayerName, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Extra arguments" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Added to every launch." Style="{StaticResource RowNote}" />
                        </StackPanel>
                        <TextBox Grid.Column="1" Style="{StaticResource Field}" Width="250" Text="{Binding ExtraArgs, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" />
                    <UniformGrid Columns="2">
                        <CheckBox Style="{StaticResource Switch}" Content="Borderless window" IsChecked="{Binding Borderless}" />
                        <CheckBox Style="{StaticResource Switch}" Content="Skip intro" IsChecked="{Binding SkipIntro}" />
                        <CheckBox Style="{StaticResource Switch}" Content="Minimise while playing" IsChecked="{Binding MinimiseWhilePlaying}" />
                        <CheckBox Style="{StaticResource Switch}" Content="Check for updates" IsChecked="{Binding CheckUpdatesOnStart}" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Files -->
            <TextBlock Text="FILES" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Margin="0,0,0,22" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Install folder" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{Binding InstallFolder}" Style="{StaticResource RowNote}" ToolTip="{Binding InstallFolder}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Style="{StaticResource Small}" Content="Change…" Command="{Binding ChangeFolderCommand}"
                                    Visibility="{Binding CanChangeFolder, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource Small}" Content="Open" Command="{Binding OpenInstallFolderCommand}" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Imported from" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="{Binding ImportedFrom}" Style="{StaticResource RowNote}" ToolTip="{Binding ImportedFrom}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Small}" Content="Re-import" Command="{Binding ReimportCommand}" Margin="12,0,0,0" />
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Repair" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Check every game file, or rebuild the four core lvls." Style="{StaticResource RowNote}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource Small}" Content="Verify files" Command="{Binding VerifyCommand}" />
                            <Button Style="{StaticResource Small}" Content="Rebuild core files" Command="{Binding RebuildCommand}" />
                        </StackPanel>
                    </Grid>
                    <Rectangle Style="{StaticResource Divider}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Folders" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Small}" Content="Saves" Command="{Binding OpenSavesCommand}" />
                            <Button Style="{StaticResource Small}" Content="Mods" Command="{Binding OpenModsCommand}" />
                            <Button Style="{StaticResource Small}" Content="Crash reports" Command="{Binding OpenCrashesCommand}" />
                            <Button Style="{StaticResource Small}" Content="Logs" Command="{Binding OpenLogsCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="ABOUT" Style="{StaticResource Section}" />
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" FontWeight="SemiBold">
                        <Run Text="OpenBattlefront" />
                        <Run Text="{Binding LauncherVersion, Mode=OneWay}" Foreground="{StaticResource Muted}" FontWeight="Normal" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="A launcher for OpenSWBF2, the open-source rebuild of Star Wars Battlefront II (2005). It runs the game from your own copy and never ships game files." />
                    <TextBlock Style="{StaticResource Body}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,8,0,0"
                               Text="Game builds include FFmpeg (LGPL 2.1) and DXVK (zlib). Not affiliated with or endorsed by EA, Disney or Lucasfilm." />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource LinkButton}" Content="OpenBattlefront on GitHub" Command="{Binding OpenUrlCommand}"
                                CommandParameter="https://github.com/jt-marte/OpenBattlefront" />
                        <Button Style="{StaticResource LinkButton}" Content="OpenSWBF2 on GitHub" Margin="20,0,0,0" Command="{Binding OpenUrlCommand}"
                                CommandParameter="https://github.com/jt-marte/OpenSWBF2" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
