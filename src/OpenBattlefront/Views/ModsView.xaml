<UserControl x:Class="OpenBattlefront.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <Grid Margin="40,52,40,26" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Mods" Style="{StaticResource H2}" />
                <TextBlock Text="Drop a mod folder or .zip anywhere here. Switch one off to keep it without loading it."
                           Style="{StaticResource Body}" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,0,0"
                    Visibility="{Binding CanManage, Converter={StaticResource Vis}}">
            <Button Style="{StaticResource GhostButton}" Content="Add folder" Command="{Binding AddFolderCommand}" Height="32" Padding="12,0" />
            <Button Style="{StaticResource GhostButton}" Content="Add .zip" Command="{Binding AddZipCommand}" Height="32" Padding="12,0" Margin="6,0,0,0" />
            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Command="{Binding OpenFolderCommand}" ToolTip="Open the AddOn folder" Margin="4,0,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasItems, Converter={StaticResource Vis}}">
                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,8,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                                    Padding="16,0,8,0" Height="54" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="Load this mod" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="14" />
                                        <TextBlock Text="{Binding State}" FontSize="12" Foreground="{StaticResource Faint}" Margin="10,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="&#xE838;" Command="{Binding OpenCommand}" ToolTip="Open folder" />
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding RemoveCommand}" ToolTip="Remove" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty, or not imported yet -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Vis}}">
                <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource AccentSoft}">
                    <TextBlock Text="&#xEA86;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{StaticResource Accent}" />
                </Border>
                <TextBlock Text="No mods yet" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock Text="Drop a mod here. A mod folder has an addme.script file in it." Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding CanManage, Converter={StaticResource NotVis}}">
                <TextBlock Text="Import your game first" Style="{StaticResource H3}" HorizontalAlignment="Center" />
                <TextBlock Text="Mods are added to OpenBattlefront's copy, so start on the Play page." Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <Rectangle RadiusX="12" RadiusY="12" StrokeDashArray="5 4" StrokeThickness="1.5" Stroke="{StaticResource Accent}" Fill="#143B7DED"
                       IsHitTestVisible="False" Visibility="{Binding DragHover, Converter={StaticResource Vis}}" />
        </Grid>

        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,12,0,0"
                   Text="Mods that need the unofficial 1.3 patch don't work yet. Built-in support for them is next." />
    </Grid>
</UserControl>
