<UserControl x:Class="OpenBattlefront.Views.RemoteAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Self">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,40,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="40,4,40,14">
            <StackPanel>
                <Button Style="{StaticResource LinkButton}" Command="{Binding BackCommand, ElementName=Self}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="11" />
                        <TextBlock Text="Server manager" Margin="6,0,0,0" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Connect to server as admin" Style="{StaticResource H2}" Margin="0,6,0,0"
                           Visibility="{Binding IsDisconnected, Converter={StaticResource Vis}}" />
                <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource Vis}}" Margin="0,6,0,0">
                    <TextBlock Text="{Binding ServerName}" Style="{StaticResource H2}" TextTrimming="CharacterEllipsis" Margin="0,0,120,0" />
                    <TextBlock Text="{Binding ServerDetail}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,4,0,0" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Visibility="{Binding IsConnected, Converter={StaticResource Vis}}">
                <Button Style="{StaticResource IconButton}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="Read the server's mods again" />
                <Button Style="{StaticResource GhostButton}" Content="Disconnect" Command="{Binding DisconnectCommand}" Height="30" Padding="12,0" Margin="6,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- Not connected: address and admin password -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsDisconnected, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}" Margin="40,0,40,16" Padding="24,22" Width="480" HorizontalAlignment="Left" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Style="{StaticResource Body}"
                               Text="The server's address and its admin password: ADMIN_PASSWORD, or config/admin-password on the Docker server." />
                    <TextBlock Text="ADDRESS" Style="{StaticResource Caption}" Margin="2,18,0,6" />
                    <TextBox Style="{StaticResource Field}" MaxLength="63" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="address:port, such as 203.0.113.5:3658" />
                    <TextBlock Text="ADMIN PASSWORD" Style="{StaticResource Caption}" Margin="2,14,0,6" />
                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource SecretField}" MaxLength="31" PasswordChanged="OnPasswordChanged" />
                    <Grid Margin="0,20,0,0">
                        <TextBlock Style="{StaticResource Caption}" FontWeight="Normal" TextWrapping="Wrap" Margin="0,0,120,0" VerticalAlignment="Center"
                                   Text="Mods travel over TCP on the game's port number: the server forwards it as TCP and UDP." />
                        <Button Style="{StaticResource PrimaryButton}" Content="Connect" Command="{Binding ConnectCommand}" HorizontalAlignment="Right" IsDefault="True" MinWidth="100" />
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Connected: the server's mods and yours -->
        <Grid Grid.Row="1" Margin="40,0,40,8" Visibility="{Binding IsConnected, Converter={StaticResource Vis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- The match: phase, the launchers' lobby, start and back to lobby -->
            <Border Grid.ColumnSpan="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                    Padding="16,10,10,10" Margin="0,0,4,14" Visibility="{Binding HasMatch, Converter={StaticResource Vis}}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,330,0">
                        <TextBlock Text="{Binding MatchText}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MatchDetail}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource GhostButton}" Content="Cancel start" Command="{Binding CancelStartCommand}" Height="32" Padding="12,0"
                                Visibility="{Binding IsStartLoading, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource GhostButton}" Content="Back to lobby" Command="{Binding BackToLobbyCommand}" Height="32" Padding="12,0" Margin="6,0,0,0"
                                ToolTip="The next map waits in the lobby until you start it" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding StartMatchCommand}" Height="32" Padding="14,0" Margin="6,0,0,0"
                                ToolTip="Opens the waiting players' games, then starts the match once they're in">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="11" />
                                <TextBlock Text="Start match" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Grid.Row="1" Text="ON THE SERVER" Style="{StaticResource Caption}" Margin="2,0,0,8" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ServerMods}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                                    Padding="14,9,6,9" Margin="0,0,4,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12" Foreground="{StaticResource Faint}" Margin="0,2,0,0">
                                            <Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SourceText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Chip}" Visibility="{Binding HasPending, Converter={StaticResource Vis}}" Margin="8,0,4,0">
                                            <TextBlock Text="{Binding Pending}" FontSize="11" Foreground="{StaticResource Accent}" />
                                        </Border>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding RemoveCommand}" ToolTip="Remove from the server"
                                                Visibility="{Binding CanRemove, Converter={StaticResource Vis}}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Column="2" Grid.Row="1" Text="YOURS" Style="{StaticResource Caption}" Margin="2,0,0,8" />
            <ScrollViewer Grid.Column="2" Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding LocalMods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                                        Padding="14,9,10,9" Margin="0,0,4,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="14" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                                                <Run Text="{Binding SizeText, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Faint}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding StateText}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Height="30" Padding="12,0" Margin="10,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding UploadCommand}" Visibility="{Binding CanUpload, Converter={StaticResource Vis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="12" />
                                                <TextBlock Text="Upload" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Your mods are the ones switched on in your Mods page." FontSize="11.5" Foreground="{StaticResource Faint}" Margin="2,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Footer: restart, or the job that runs -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="40,12,40,16"
                Visibility="{Binding IsConnected, Converter={StaticResource Vis}}">
            <Grid>
                <Grid Visibility="{Binding Activity.IsBusy, Converter={StaticResource NotVis}}">
                    <TextBlock Text="{Binding RestartText}" Style="{StaticResource Caption}" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,330,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="Cancel the restart" Command="{Binding CancelRestartCommand}"
                                Visibility="{Binding RestartWaits, Converter={StaticResource Vis}}" />
                        <Button Style="{StaticResource GhostButton}" Content="Restart when empty" Command="{Binding RestartWhenEmptyCommand}"
                                Visibility="{Binding RestartWaits, Converter={StaticResource NotVis}}"
                                ToolTip="The server's game restarts the next time nobody is on" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Restart now" Command="{Binding RestartNowCommand}" Margin="8,0,0,0"
                                ToolTip="Players are dropped and can rejoin" />
                    </StackPanel>
                </Grid>
                <Grid Visibility="{Binding Activity.IsBusy, Converter={StaticResource Vis}}">
                    <StackPanel Margin="0,0,110,0" VerticalAlignment="Center">
                        <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Activity.Title, Mode=OneWay}" Foreground="{StaticResource Text}" />
                            <Run Text="{Binding Activity.Detail, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                        </TextBlock>
                        <ProgressBar Style="{StaticResource Thin}" Margin="0,7,0,0" Maximum="1" Value="{Binding Activity.Fraction, Mode=OneWay}"
                                     IsIndeterminate="{Binding Activity.IsIndeterminate, Mode=OneWay}" />
                    </StackPanel>
                    <Button Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Right" Height="30" Padding="14,0"
                            Command="{Binding Activity.CancelCommand}" Visibility="{Binding Activity.CanCancel, Converter={StaticResource Vis}}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
