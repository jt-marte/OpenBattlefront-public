<UserControl x:Class="OpenBattlefront.Views.RemoteAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:OpenBattlefront.Views"
             x:Name="Self">
    <Grid>
        <!-- Not connected: address and admin password -->
        <Grid Margin="0,40,0,0" Visibility="{Binding IsDisconnected, Converter={StaticResource Vis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="40,4,40,14">
                <Button Style="{StaticResource LinkButton}" Command="{Binding BackCommand, ElementName=Self}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="11" />
                        <TextBlock Text="Server manager" Margin="6,0,0,0" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Connect to server as admin" Style="{StaticResource H2}" Margin="0,6,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Margin="40,0,40,16" Padding="24,22" Width="480" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Body}"
                                   Text="The server's address and its admin password: ADMIN_PASSWORD, or config/admin-password on the Docker server. You get the same playlist and controls as Host a server." />
                        <TextBlock Text="ADDRESS" Style="{StaticResource Caption}" Margin="2,18,0,6" />
                        <TextBox Style="{StaticResource Field}" MaxLength="63" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="address:port, such as 203.0.113.5:3658" />
                        <TextBlock Text="ADMIN PASSWORD" Style="{StaticResource Caption}" Margin="2,14,0,6" />
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource SecretField}" MaxLength="31" PasswordChanged="OnPasswordChanged" />
                        <Grid Margin="0,20,0,0">
                            <TextBlock Style="{StaticResource Caption}" FontWeight="Normal" TextWrapping="Wrap" Margin="0,0,120,0" VerticalAlignment="Center"
                                       Text="Admin commands go over UDP on the game's port, mods over TCP on the same number: the server forwards both." />
                            <Button Style="{StaticResource PrimaryButton}" Content="Connect" Command="{Binding ConnectCommand}" HorizontalAlignment="Right" IsDefault="True" MinWidth="100" />
                        </Grid>
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding Activity.IsBusy, Converter={StaticResource Vis}}">
                            <TextBlock FontSize="12.5" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Activity.Title, Mode=OneWay}" Foreground="{StaticResource Text}" />
                                <Run Text="{Binding Activity.Detail, Mode=OneWay}" Foreground="{StaticResource Muted}" />
                            </TextBlock>
                            <ProgressBar Style="{StaticResource Thin}" Margin="0,7,0,0" Maximum="1" Value="{Binding Activity.Fraction, Mode=OneWay}"
                                         IsIndeterminate="{Binding Activity.IsIndeterminate, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Connected: the same playlist and control screen as hosting, with the server's mods as a tab -->
        <views:ServerControlView DataContext="{Binding Control}"
                                 Visibility="{Binding DataContext.IsConnected, ElementName=Self, Converter={StaticResource Vis}}" />
    </Grid>
</UserControl>
