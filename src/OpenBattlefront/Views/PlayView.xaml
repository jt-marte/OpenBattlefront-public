<UserControl x:Class="OpenBattlefront.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" DragEnter="OnDragOver" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop">
    <Grid ClipToBounds="True">

        <!-- Backdrop: our own art only. A night sky, a warm glow and a planet's horizon. -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0E1424" Offset="0" />
                    <GradientStop Color="#0A0D14" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Canvas x:Name="Stars" IsHitTestVisible="False" />
        <Ellipse Width="640" Height="640" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-330,-250,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#333B7DED" Offset="0" />
                    <GradientStop Color="#003B7DED" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="200" Canvas.Top="440" Width="1420" Height="1420" StrokeThickness="10" Opacity="0.55">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0">
                        <GradientStop Color="#003B7DED" Offset="0.12" />
                        <GradientStop Color="#993B7DED" Offset="0.5" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
                <Ellipse.Effect>
                    <BlurEffect Radius="22" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Left="200" Canvas.Top="440" Width="1420" Height="1420" StrokeThickness="1.2">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.25" GradientOrigin="0.5,0" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#131B2C" Offset="0" />
                        <GradientStop Color="#0A0D14" Offset="0.6" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0">
                        <GradientStop Color="#005B95F2" Offset="0.15" />
                        <GradientStop Color="#E67AAAF5" Offset="0.5" />
                    </LinearGradientBrush>
                </Ellipse.Stroke>
            </Ellipse>
        </Canvas>

        <!-- Stages (hidden while a job runs) -->
        <Grid Margin="48,64,48,44" Visibility="{Binding Activity.IsBusy, Converter={StaticResource NotVis}}">

            <!-- Ready: the big button -->
            <Grid Visibility="{Binding Stage, Converter={StaticResource Show}, ConverterParameter=Ready}">
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="17" Padding="14,0,6,0" Height="34"
                        Background="#CC141B2A" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource Vis}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding UpdateText}" FontSize="12.5" Margin="9,0,12,0" VerticalAlignment="Center" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Update" Height="24" Padding="12,0" FontSize="12" Command="{Binding UpdateCommand}" />
                    </StackPanel>
                </Border>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding VersionCaption}" Style="{StaticResource Caption}" />
                    <TextBlock Text="Battlefront II" Style="{StaticResource H1}" Margin="-2,4,0,0" />
                    <TextBlock Text="The 2005 classic, rebuilt for 64-bit and Vulkan." Style="{StaticResource Body}" FontSize="14" Margin="0,2,0,26" />
                    <Button Style="{StaticResource PrimaryButton}" Height="50" Width="184" HorizontalAlignment="Left" Command="{Binding PlayCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="14" />
                            <TextBlock Text="{Binding PlayLabel}" FontSize="15" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ItemsControl ItemsSource="{Binding MissingPrereqs}" Margin="0,18,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Accent}" />
                                    <TextBlock Text="{Binding Name, StringFormat='{}{0} is missing.'}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="8,0,8,0" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource LinkButton}" Content="Get it" FontSize="12.5" VerticalAlignment="Center"
                                            Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding Url}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- Welcome: find or drop the game -->
            <StackPanel Width="470" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Stage, Converter={StaticResource Show}, ConverterParameter=Welcome}">
                <Grid>
                    <Rectangle RadiusX="16" RadiusY="16" StrokeDashArray="5 4" StrokeThickness="1.5" Fill="#B30D1220">
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="Stroke" Value="#33405A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DragHover}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter Property="Fill" Value="#1A3B7DED" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>
                    <StackPanel Margin="40,40,40,36">
                        <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource AccentSoft}">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{StaticResource Accent}" />
                        </Border>
                        <TextBlock Text="Drop your Battlefront II folder here" Style="{StaticResource H2}" FontSize="20" HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource Body}" TextAlignment="Center" Margin="0,8,0,0"
                                   Text="The Steam version, v1.1. OpenBattlefront copies what the game needs (about 10 GB) and never changes your copy." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                            <Button Style="{StaticResource GhostButton}" Content="Browse…" Command="{Binding BrowseCommand}" />
                            <Button Style="{StaticResource GhostButton}" Content="Resume last import" Margin="8,0,0,0" Command="{Binding ResumeCommand}"
                                    Visibility="{Binding CanResume, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Found through Steam -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12,12,12" Visibility="{Binding HasSteamCopy, Converter={StaticResource Vis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{StaticResource Success}" />
                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                            <TextBlock Text="Found your Steam copy" Style="{StaticResource H3}" FontSize="13.5" />
                            <TextBlock Text="{Binding SteamCopy}" FontSize="12" Foreground="{StaticResource Faint}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                       ToolTip="{Binding SteamCopy}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Use this copy" Command="{Binding UseSteamCopyCommand}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding InstallHint}" Style="{StaticResource Caption}" FontWeight="Normal" HorizontalAlignment="Center" Margin="0,14,0,0"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Checking -->
            <StackPanel Width="300" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Stage, Converter={StaticResource Show}, ConverterParameter=Checking}">
                <TextBlock Text="Checking your game files…" Style="{StaticResource H3}" HorizontalAlignment="Center" />
                <ProgressBar Style="{StaticResource Thin}" IsIndeterminate="True" Margin="0,16,0,0" />
            </StackPanel>

            <!-- Review -->
            <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,26"
                    Visibility="{Binding Stage, Converter={StaticResource Show}, ConverterParameter=Review}">
                <StackPanel>
                    <TextBlock Text="Ready to import" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding SourcePath}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}" />
                    <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,18" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Success}" />
                        <TextBlock Text="Steam v1.1 core files check out" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{StaticResource Muted}" />
                        <TextBlock Text="{Binding ReviewSize}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" Content="{Binding ProfilesLabel}" IsChecked="{Binding ImportProfiles}" Margin="0,18,0,0"
                              Visibility="{Binding HasProfiles, Converter={StaticResource Vis}}" />
                    <CheckBox Style="{StaticResource Switch}" Content="{Binding ModsLabel}" IsChecked="{Binding ImportMods}" Margin="0,12,0,0"
                              Visibility="{Binding HasMods, Converter={StaticResource Vis}}" />
                    <CheckBox Style="{StaticResource Switch}" Content="{Binding EssentialsLabel}" IsChecked="{Binding WantEssentials}" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Import" Width="120" Command="{Binding ImportCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Back" Margin="8,0,0,0" Command="{Binding BackCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Invalid -->
            <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,26"
                    Visibility="{Binding Stage, Converter={StaticResource Show}, ConverterParameter=Invalid}">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource DangerSoft}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Danger}" />
                    </Border>
                    <TextBlock Text="Those files won't work" Style="{StaticResource H2}" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding InvalidMessage}" Style="{StaticResource Body}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Choose another folder" Command="{Binding BrowseCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Back" Margin="8,0,0,0" Command="{Binding BackCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Needs a game build -->
            <Border Style="{StaticResource Card}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,26"
                    Visibility="{Binding Stage, Converter={StaticResource Show}, ConverterParameter=NeedsBuild}">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource AccentSoft}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{StaticResource Accent}" />
                    </Border>
                    <TextBlock Text="Almost there" Style="{StaticResource H2}" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,8,0,0"
                               Text="Your game files are in. Now install OpenSWBF2, the rebuilt game, and OpenBattlefront builds the rest on your PC." />
                    <TextBlock Text="{Binding ReleaseNote}" FontSize="12.5" Foreground="{StaticResource Faint}" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding DownloadLabel}" Command="{Binding UpdateCommand}" />
                        <Button Style="{StaticResource GhostButton}" Content="Choose package…" Margin="8,0,0,0" Command="{Binding ChoosePackageCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Working -->
        <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Activity.IsBusy, Converter={StaticResource Vis}}">
            <TextBlock Text="{Binding Activity.Title}" Style="{StaticResource H2}" FontSize="20" />
            <TextBlock Text="{Binding Activity.Detail}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
            <ProgressBar Style="{StaticResource Thin}" Margin="0,18,0,0" Maximum="1"
                         Value="{Binding Activity.Fraction, Mode=OneWay}" IsIndeterminate="{Binding Activity.IsIndeterminate, Mode=OneWay}" />
            <Grid Margin="0,18,0,0">
                <TextBlock Text="Your own copy stays untouched." FontSize="12" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                <Button Style="{StaticResource GhostButton}" Content="Cancel" HorizontalAlignment="Right" Height="30" Padding="14,0"
                        Command="{Binding Activity.CancelCommand}" Visibility="{Binding Activity.CanCancel, Converter={StaticResource Vis}}" />
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
