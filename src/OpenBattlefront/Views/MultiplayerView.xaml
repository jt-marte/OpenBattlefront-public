<UserControl x:Class="OpenBattlefront.Views.MultiplayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="40,52,40,26">

        <!-- Direct Connect: as the game's own tab -->
        <Grid Visibility="{Binding Screen, Converter={StaticResource Show}, ConverterParameter=Connect}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="Direct Connect" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" MaxWidth="600" HorizontalAlignment="Left"
                           Text="Join a server by its address. The launcher gets the mods it uses, then you wait in its lobby, and the game opens on the server when the match starts." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="22,20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="SERVER ADDRESS" Style="{StaticResource Caption}" Margin="2,0,0,6" />
                        <TextBox x:Name="AddressBox" Style="{StaticResource Field}" MaxLength="63"
                                 Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" ToolTip="address:port, such as 203.0.113.5:3658 or myserver.example.com" />
                        <TextBlock Text="The port is 3658 unless the server says otherwise." FontSize="11.5" Foreground="{StaticResource Faint}" Margin="2,6,0,0" />
                        <TextBlock Text="PASSWORD (IF ANY)" Style="{StaticResource Caption}" Margin="2,16,0,6" />
                        <PasswordBox x:Name="PasswordInput" Style="{StaticResource SecretField}" MaxLength="15" PasswordChanged="OnPasswordChanged" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding JoinCommand}" IsDefault="True" Height="40" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="13" />
                                <TextBlock Text="Join" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding ReadyHint}" FontSize="12" Foreground="{StaticResource Muted}" Margin="2,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="RECENT SERVERS" Style="{StaticResource Caption}" Margin="2,0,0,8" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasRecent, Converter={StaticResource Vis}}">
                        <ItemsControl ItemsSource="{Binding Recent}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,4,8">
                                        <Button Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}" HorizontalContentAlignment="Stretch" ToolTip="Fill in this server">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                            CornerRadius="10" Padding="16,10,44,10">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="26" Height="26" Margin="0,0,10,0"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="Forget this server"
                                                Command="{Binding DataContext.ForgetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,14"
                            VerticalAlignment="Top" Visibility="{Binding HasRecent, Converter={StaticResource NotVis}}">
                        <TextBlock Text="Servers you join show up here." FontSize="12.5" Foreground="{StaticResource Muted}" />
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- The lobby: waiting with the game closed -->
        <Grid Visibility="{Binding Screen, Converter={StaticResource Show}, ConverterParameter=Lobby}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,-12,0,0">
                <Button Style="{StaticResource LinkButton}" Command="{Binding LeaveCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" Style="{StaticResource Glyph}" FontSize="11" />
                        <TextBlock Text="Leave the lobby" Margin="6,0,0,0" FontSize="12.5" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding ServerName}" Style="{StaticResource H2}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding MapText}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="0,4,0,0" />
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16" Margin="0,18,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Muted}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding StateText}" Style="{StaticResource H3}" FontSize="15" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Caption}" FontWeight="Normal" Margin="21,6,0,0" />
                    <StackPanel Margin="21,14,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Activity.Detail}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Style="{StaticResource Thin}" Margin="0,8,0,0" Maximum="1" Value="{Binding Activity.Fraction, Mode=OneWay}"
                                     IsIndeterminate="{Binding Activity.IsIndeterminate, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,18,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="PLAYERS" Style="{StaticResource Caption}" Margin="2,0,0,8" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Players}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                                        Padding="14,9" Margin="0,0,8,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Faint}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="10" Padding="8,2" Background="{StaticResource AccentSoft}" VerticalAlignment="Center"
                                                Visibility="{Binding IsMe, Converter={StaticResource Vis}}">
                                            <TextBlock Text="You" FontSize="11" Foreground="{StaticResource Accent}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                <Grid>
                    <TextBlock Style="{StaticResource Caption}" FontWeight="Normal" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,140,0"
                               Text="The game opens on the server by itself when the match starts. Keep the launcher open until then." />
                    <Button Style="{StaticResource GhostButton}" Content="Leave the lobby" Command="{Binding LeaveCommand}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
