<Window x:Class="OpenBattlefront.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenBattlefront.ViewModels"
        xmlns:views="clr-namespace:OpenBattlefront.Views"
        Title="OpenBattlefront"
        Width="1200" Height="750"
        ResizeMode="CanMinimize" WindowStyle="None" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Ui}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Icon="Assets/app.ico">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:PlayViewModel}">
            <views:PlayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MultiplayerViewModel}">
            <views:MultiplayerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModsViewModel}">
            <views:ModsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ServersViewModel}">
            <views:ServersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,20,14,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,30">
                    <Grid Width="22" Height="22">
                        <Ellipse Width="18" Height="18" Stroke="{StaticResource Accent}" StrokeThickness="2" />
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Text}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0" />
                    </Grid>
                    <TextBlock Text="OpenBattlefront" FontSize="15" FontWeight="SemiBold" Margin="11,0,0,1" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="10,0,4,0">
                    <StackPanel Visibility="{Binding ShowFooterActivity, Converter={StaticResource Vis}}" Margin="0,0,0,14">
                        <TextBlock Text="{Binding Activity.Title}" FontSize="12" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Style="{StaticResource Thin}" Margin="0,7,0,0" Maximum="1" Value="{Binding Activity.Fraction, Mode=OneWay}"
                                     IsIndeterminate="{Binding Activity.IsIndeterminate, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LauncherVersionText}" Style="{StaticResource Caption}" />
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE768;" Content="Play"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Play}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE716;" Content="Multiplayer"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Multiplayer}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xEA86;" Content="Mods"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Mods}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE774;" Content="Server manager"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Servers}" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Settings"
                                 IsChecked="{Binding Page, Converter={StaticResource Eq}, ConverterParameter=Settings}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Page -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentView}" Focusable="False" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimise" ToolTip="Minimise"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="Close"
                        WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>

            <!-- Notice -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,22" MaxWidth="560"
                    CornerRadius="10" BorderThickness="1" Padding="16,10,8,10"
                    Visibility="{Binding HasNotice, Converter={StaticResource Vis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource SurfaceHi}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                <Setter Property="Background" Value="#2A1717" />
                                <Setter Property="BorderBrush" Value="#5A2A27" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Top" Margin="0,2,10,0" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                <Setter Property="Text" Value="&#xE73E;" />
                                <Setter Property="Foreground" Value="{StaticResource Success}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Notice}" FontSize="13" Foreground="{StaticResource Text}"
                               TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10" Width="26" Height="26"
                            Margin="8,-2,0,0" VerticalAlignment="Top" Command="{Binding DismissNoticeCommand}" ToolTip="Dismiss" />
                </Grid>
            </Border>
        </Grid>

        <!-- Confirm -->
        <Grid Grid.ColumnSpan="2" Background="#B3050608" Visibility="{Binding ConfirmOpen, Converter={StaticResource Vis}}">
            <Border Style="{StaticResource Card}" Width="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,22" Background="{StaticResource SurfaceHi}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmTitle}" Style="{StaticResource H3}" FontSize="17" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ConfirmText}" Style="{StaticResource Body}" Margin="0,8,0,22" />
                    <TextBox Style="{StaticResource Field}" MaxLength="15" Margin="0,-8,0,22"
                             Text="{Binding ConfirmInput, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding ConfirmHasInput, Converter={StaticResource Vis}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource GhostButton}" Content="{Binding ConfirmCancel}" Command="{Binding ConfirmNoCommand}" IsCancel="True" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding ConfirmOk}" Command="{Binding ConfirmYesCommand}" Margin="8,0,0,0" IsDefault="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
